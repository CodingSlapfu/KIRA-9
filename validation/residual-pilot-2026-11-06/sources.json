  "chosen": [
    {
      "pair": [
        "hh",
        "iy"
      ],
      "utterance": "arctic_a0009",
      "phone_index": 1,
      "first": {
        "phone": "hh",
        "start": 0.137,
        "end": 0.212
      },
      "second": {
        "phone": "iy",
        "start": 0.212,
        "end": 0.2745
      },
      "text": "He turned sharply, and faced Gregson across the table."
    },
    {
      "pair": [
        "hh",
        "ih"
      ],
      "utterance": "arctic_a0043",
      "phone_index": 13,
      "first": {
        "phone": "hh",
        "start": 1.09325,
        "end": 1.1995
      },
      "second": {
        "phone": "ih",
        "start": 1.1995,
        "end": 1.25575
      },
      "text": "It seemed nearer to him since he had seen and talked with Gregson."
    },
    {
      "pair": [
        "hh",
        "eh"
      ],
      "utterance": "arctic_a0013",
      "phone_index": 7,
      "first": {
        "phone": "hh",
        "start": 0.487,
        "end": 0.56825
      },
      "second": {
        "phone": "eh",
        "start": 0.56825,
        "end": 0.64325
      },
      "text": "He was a head shorter than his companion, of almost delicate physique."
    },
    {
      "pair": [
        "hh",
        "ae"
      ],
      "utterance": "arctic_a0026",
      "phone_index": 20,
      "first": {
        "phone": "hh",
        "start": 1.43075,
        "end": 1.49325
      },
      "second": {
        "phone": "ae",
        "start": 1.49325,
        "end": 1.58075
      },
      "text": "It occurred to me that there would have to be an accounting."
    },
    {
      "pair": [
        "iy",
        "d"
      ],
      "utterance": "arctic_a0081",
      "phone_index": 8,
      "first": {
        "phone": "iy",
        "start": 0.5995,
        "end": 0.6745
      },
      "second": {
        "phone": "d",
        "start": 0.6745,
        "end": 0.74325
      },
      "text": "What if she did not come to the rock."
    },
    {
      "pair": [
        "ih",
        "d"
      ],
      "utterance": "arctic_a0237",
      "phone_index": 12,
      "first": {
        "phone": "ih",
        "start": 1.1745,
        "end": 1.2245
      },
      "second": {
        "phone": "d",
        "start": 1.2245,
        "end": 1.2745
      },
      "text": "So Hughie and I did the managing ourselves."
    },
    {
      "pair": [
        "eh",
        "d"
      ],
      "utterance": "arctic_a0013",
      "phone_index": 8,
      "first": {
        "phone": "eh",
        "start": 0.56825,
        "end": 0.64325
      },
      "second": {
        "phone": "d",
        "start": 0.64325,
        "end": 0.70575
      },
      "text": "He was a head shorter than his companion, of almost delicate physique."
    },
    {
      "pair": [
        "ae",
        "d"
      ],
      "utterance": "arctic_a0030",
      "phone_index": 4,
      "first": {
        "phone": "ae",
        "start": 0.34325,
        "end": 0.412
      },
      "second": {
        "phone": "d",
        "start": 0.412,
        "end": 0.48075
      },
      "text": "I had faith in them."
    },
    {
      "pair": [
        "s",
        "iy"
      ],
      "utterance": "arctic_a0004",
      "phone_index": 16,
      "first": {
        "phone": "s",
        "start": 1.23075,
        "end": 1.3495
      },
      "second": {
        "phone": "iy",
        "start": 1.3495,
        "end": 1.44325
      },
      "text": "Lord, but I'm glad to see you again, Phil."
    },
    {
      "pair": [
        "sh",
        "iy"
      ],
      "utterance": "arctic_a0036",
      "phone_index": 1,
      "first": {
        "phone": "sh",
        "start": 0.1495,
        "end": 0.30575
      },
      "second": {
        "phone": "iy",
        "start": 0.30575,
        "end": 0.36825
      },
      "text": "She turned in at the hotel."
    },
    {
      "pair": [
        "p",
        "iy"
      ],
      "utterance": "arctic_a0024",
      "phone_index": 39,
      "first": {
        "phone": "p",
        "start": 2.9245,
        "end": 2.9995
      },
      "second": {
        "phone": "iy",
        "start": 2.9995,
        "end": 3.0495
      },
      "text": "It was my reports from the north which chiefly induced people to buy."
    },
    {
      "pair": [
        "b",
        "iy"
      ],
      "utterance": "arctic_a0020",
      "phone_index": 26,
      "first": {
        "phone": "b",
        "start": 2.00575,
        "end": 2.05575
      },
      "second": {
        "phone": "iy",
        "start": 2.05575,
        "end": 2.162
      },
      "text": "Clubs and balls and cities grew to be only memories."
    }
  ],
